{
    "name": "facturascripts/fastpresupuesto",
    "description": "FastPresupuesto plugin tooling",
    "type": "project",
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "rector/rector": "^2.0"
    },
    "scripts": {
        "phpstan": "phpstan analyse -c dev/phpstan.neon --memory-limit=2G",
        "phpstan:baseline": "phpstan analyse -c dev/phpstan.neon --memory-limit=2G --generate-baseline=dev/phpstan-baseline.neon",
        "rector:check": "rector process --config dev/rector.php --dry-run",
        "rector:fix": "rector process --config dev/rector.php",
        "cs:check": "php-cs-fixer fix --config=dev/php-cs-fixer.php --dry-run --diff",
        "cs:fix": "php-cs-fixer fix --config=dev/php-cs-fixer.php",
        "quality": [
            "@cs:check",
            "@rector:check",
            "@phpstan"
        ],
        "quality:fix": [
            "@cs:fix",
            "@rector:fix",
            "@phpstan"
        ]
    },
    "require": {
        "php": ">=8.4"
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    },
    "license": "proprietary"
}

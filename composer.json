{
  "name": "facturascripts/fastpresupuesto",
  "description": "FastPresupuesto plugin tooling",
  "type": "project",
  "require-dev": {
    "phpstan/phpstan": "^1.12",
    "phpstan/phpstan-strict-rules": "^1.6",
    "friendsofphp/php-cs-fixer": "^3.66"
  },
  "scripts": {
    "phpstan": "@php vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=1G",
    "phpstan-baseline": "@php vendor/bin/phpstan analyse -c phpstan.neon --generate-baseline=phpstan-baseline.neon --memory-limit=1G",
    "cs:fix": "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --diff --verbose",
    "cs:check": "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --verbose"
  }
}
